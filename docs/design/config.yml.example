database:
  enable: true
  name: smsd
  host: localhost
  port: 3306
  username: <user_name>
  password: <password>
download:
  save_path: ./downloads
  folderize: true
  max_threads: 0
  max_retry: 3
  save_response: false
  save_error_response: true
  test_mode: false
  listening: false
  tick_naming: true
  user_login: false
log:
  log_enable: true
  log_level: INFO
  log_save: true
  log_file_path: ./logs/server.log
server:
  host: 0.0.0.0
  port: 5000
  debug_mode: true
migrate:
  source_db_name: smsd_old
  source_db_host: localhost
  source_db_port: 3306
  source_db_username: <user_name>
  source_db_password: <password>
platform:
  douyin:
    download:
      type: live
      multiple_download: true
    api:
      DOUYIN_DOMAIN: https://www.douyin.com
      IESDOUYIN_DOMAIN: https://www.iesdouyin.com
      IESDOUYIN_HEADER_REFERER: https://www.iesdouyin.com/share/user/
      LIVE_DOMAIN: https://live.douyin.com
      LIVE_DOMAIN2: https://webcast.amemv.com
      SSO_DOMAIN: https://sso.douyin.com
      WEBCAST_WSS_DOMAIN: wss://webcast5-ws-web-lf.douyin.com
