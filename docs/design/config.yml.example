environment: development/production   # 运行环境
database:
  enable: true                        # 数据库开关
  name: smsd                          # 数据库名
  host: localhost                     # 数据库 URI
  port: 3306                          # 数据库端口
  username: root                      # 数据库用户名
  password: password                  # 数据库密码

download:
  save_path: ./downloads              # 保存路径
  folderize: true                     # 是否按照文件夹保存
  max_threads: 0                      # 下载线程数，当为 0 时，将不做下载数量限制
  max_retry: 3                        # 最大重试次数
  save_response: false                # 是否保存下载过程中服务器响应内容
  save_error_response: true           # 下载失败时是否保存错误响应内容
  test_mode: false                    # 测试模式：该模式下不会下载数据，仅会执行下载流程
  listening: false                    # 监听下载列表，当为 True 时，会不断监听列表
  tick_naming: true                   # 下载文件名前面加上时间
  user_login: false                   # 是否需要用户登录才能下载

log:
  log_enable: true                    # 日志打印开关
  log_level: INFO                     # 日志等级
  log_save: true                      # 日志保存开关
  log_file_path: ./logs/server.log    # 日志保存位置

server:
  host: 0.0.0.0                       # 主机
  port: 5000                          # 端口
  debug_mode: true                    # 是否启用调试模式（生产环境必须设为 false）

migrate:
  source_db_name: smsd_old
  source_db_host: localhost
  source_db_port: 3306
  source_db_username: <user_name>
  source_db_password: <password>