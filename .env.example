# ============================================
# Environment Configuration Template
# ============================================
# 使用说明：
# 1. 复制此文件为 .env (cp .env.example .env)
# 2. 填写实际的配置值
# 3. .env 文件已加入 .gitignore，不会被提交到代码仓库
# ============================================

# ============================================
# 数据库配置
# ============================================
MYSQL_DB_ENABLE=true_or_false
MYSQL_HOST=your_database_host
MYSQL_DB_NAME=your_source_database_name
MYSQL_PORT=your_database_port
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password

# ============================================
# 下载配置
# ============================================
# 视频保存路径（请使用绝对路径）
DOWNLOAD_SAVE_PATH=/path/to/your/video/folder

# 下载线程数（0 表示不限制）
DOWNLOAD_MAX_THREAD=your_max_thread_count

# ============================================
# 服务器配置
# ============================================
# Flask 服务运行端口
SERVER_PORT=your_server_port

# 是否启用调试模式（生产环境必须设为 false）
FLASK_DEBUG=true_or_false

# ============================================
# 旧库迁移配置
# ============================================
SOURCE_MYSQL_DB_NAME=your_source_database_name
SOURCE_MYSQL_HOST=your_database_host
SOURCE_MYSQL_PORT=your_database_port
SOURCE_MYSQL_USER=your_database_user
SOURCE_MYSQL_PASSWORD=your_database_password