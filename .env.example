# ============================================
# Environment Configuration Template
# ============================================
# 使用说明：
# 1. 复制此文件为 .env (cp .env.example .env)
# 2. 填写实际的配置值
# 3. .env 文件已加入 .gitignore，不会被提交到代码仓库
# ============================================

# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_media_stream_downloader
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here

# ============================================
# 抖音配置 - 登录相关
# ============================================
# 抖音登录状态的 Cookie（从浏览器开发者工具获取）
# 获取方法：
# 1. 浏览器打开抖音并登录
# 2. 按 F12 打开开发者工具
# 3. 进入 Network 标签，刷新页面
# 4. 点击任意请求，在 Headers 中找到 Cookie
# 5. 复制完整的 Cookie 值粘贴到下方

# share_live_url 请求使用的 Cookie
DOUYIN_COOKIE_SHARE_LIVE_URL=your_cookie_for_share_live_url

# live_room_info 请求使用的 Cookie
DOUYIN_COOKIE_LIVE_ROOM_INFO=your_cookie_for_live_room_info

# post_info 请求使用的 Cookie
DOUYIN_COOKIE_POST_INFO=your_cookie_for_post_info

# msToken 用于抖音接口验证（从浏览器请求中获取）
DOUYIN_MSTOKEN=your_mstoken_here

# ============================================
# 下载配置
# ============================================
# 视频保存路径（请使用绝对路径）
DOWNLOAD_SAVE_PATH=/path/to/your/video/folder

# 下载线程数（0 表示不限制）
DOWNLOAD_MAX_THREAD=0

# ============================================
# 服务器配置
# ============================================
# Flask 服务运行端口
SERVER_PORT=5000

# 是否启用调试模式（生产环境必须设为 false）
FLASK_DEBUG=false
