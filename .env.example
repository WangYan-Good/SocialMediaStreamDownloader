# ============================================
# Local Environment Configuration Template
# ============================================
# 1. Copy this file to .env
# 2. Fill real values locally
# 3. Never commit .env

# ============================================
# Application database configuration
# ============================================
SMSD_DB_ENABLE=true
SMSD_DB_HOST=localhost
SMSD_DB_PORT=3306
SMSD_DB_NAME=social_media_stream_downloader
SMSD_DB_USER=your_database_user
SMSD_DB_PASSWORD=your_secure_password_here
SMSD_ROOT_PASSWORD=your_database_root_password_here
SMSD_MAX_CONNECTIONS=100

# ============================================
# Download and runtime configuration
# ============================================
SMSD_DOWNLOAD_SAVE_PATH=/path/to/your/video/folder
SMSD_DOWNLOAD_MAX_THREAD=0
SMSD_LOG_ENABLE=true
SMSD_LOG_PATH=./logs
SMSD_DEBUG=false
SMSD_SAVE_RESPONSE=false
SMSD_SAVE_ERROR_RESPONSE=true

# ============================================
# Flask server configuration
# ============================================
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
FLASK_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=/path/to/your/log/folder

# ============================================
# 用户配置
# ============================================
USER_CONFIG_PATH=/path/to/your/user_config.yml

# ============================================
# Optional API token for POST /
# ============================================
SMSD_API_TOKEN=replace_with_a_random_local_token

# ============================================
# Douyin credentials
# ============================================
DOUYIN_LOGIN=false
DOUYIN_COOKIE_SHARE_LIVE_URL=
DOUYIN_COOKIE_LIVE_ROOM_INFO=
DOUYIN_COOKIE_POST_INFO=
DOUYIN_COOKIE_SHARE_LIVE_URL_NO_LOGIN=
DOUYIN_COOKIE_LIVE_ROOM_INFO_NO_LOGIN=
DOUYIN_COOKIE_POST_INFO_NO_LOGIN=
DOUYIN_MSTOKEN=

# ============================================
# Legacy database migration configuration
# ============================================
SOURCE_MYSQL_DB_NAME=old_social_media_stream_downloader
SOURCE_MYSQL_HOST=localhost
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_USER=your_database_user
SOURCE_MYSQL_PASSWORD=your_secure_password_here
