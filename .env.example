# ============================================
# Environment Configuration Template
# ============================================
# 使用说明：
# 1. 复制此文件为 .env (cp .env.example .env)
# 2. 填写实际的配置值
# 3. .env 文件已加入 .gitignore，不会被提交到代码仓库
# ============================================

ENVIRONMENT=development/production

# ============================================
# 数据库配置, 焊死在 .env 文件中
# 否则系统将连接不上数据库，无法正常工作
# ============================================
SMSD_DB_ENABLE=true
SMSD_DB_HOST=localhost
SMSD_DB_NAME=social_media_stream_downloader
SMSD_DB_PORT=3306
SMSD_DB_USER=your_database_user
SMSD_DB_PASSWORD=your_secure_password_here

# ============================================
# 默认下载配置，TODO: 移动至用户配置
# 以 DB 配置为主，.env 中的配置仅作为默认值
# ============================================
# 视频保存路径（请使用绝对路径）
DOWNLOAD_SAVE_PATH=/path/to/your/video/folder

# 下载线程数（0 表示自动根据 CPU 核心数设置）
DOWNLOAD_MAX_THREADS=0

# ============================================
# 服务器配置
# 以 DB 配置为主，.env 中的配置仅作为默认值
# ============================================
# Flask 默认服务运行端口
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# 是否启用调试模式（生产环境必须设为 false）
FLASK_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=/path/to/your/log/folder

# ============================================
# 旧库迁移配置（legacy_to_v2）
# 以 .env 中的配置为主
# ============================================
SOURCE_MYSQL_DB_NAME=old_social_media_stream_downloader
SOURCE_MYSQL_HOST=localhost
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_USER=your_database_user
SOURCE_MYSQL_PASSWORD=your_secure_password_here